# Public origin of the deployed site, no trailing slash. Used for canonical URLs, sitemap and Open Graph.
SITE_URL=https://www.example.com
# Port for `npm start`
PORT=3000

# Temporary share links (optional; they work without any setting on the Node server)
# SHARE_TTL_HOURS=24
# SHARE_MAX_MB=100
# SHARE_DIR=
# SHARE_DISABLED=false
# Vercel only: created by adding a Blob store to the project
# BLOB_READ_WRITE_TOKEN=
# CRON_SECRET=

# Google Drive and Dropbox buttons (public identifiers, read at build time; the buttons stay hidden when unset)
# VITE_GOOGLE_CLIENT_ID=
# VITE_GOOGLE_API_KEY=
# VITE_GOOGLE_APP_ID=
# VITE_DROPBOX_APP_KEY=
